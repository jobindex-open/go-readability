 internal/re2go/base.go         |    2 -
 internal/re2go/base.re         |   18 -
 internal/re2go/check-byline.go |  330 -----
 internal/re2go/check-byline.re |   20 -
 internal/re2go/class-weight.go | 2160 --------------------------------
 internal/re2go/class-weight.re |  100 --
 internal/re2go/grab-article.go | 2074 ------------------------------
 internal/re2go/grab-article.re |   39 -
 internal/re2go/normalize.go    |   95 --
 internal/re2go/normalize.re    |   42 -
 internal/re2go/re2go_test.go   |  249 ----
 parser-check.go                |    5 +-
 parser.go                      |  154 ++-
 utils.go                       |    4 +-
 15 files changed, 79 insertions(+), 5226 deletions(-)
